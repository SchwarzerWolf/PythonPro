# Скопируйте этот файл в .env и укажите пути своей машины.
# Запуск: uv run --env-file .env python main.py reinvent

# Исполняемый файл reinvent из окружения REINVENT4
# Windows: C:/Users/<user>/REINVENT4/.venv/Scripts/reinvent.exe
REINVENT_EXECUTABLE=/home/<user>/REINVENT4/.venv/bin/reinvent

# Файл модели (prior), из которой генерируются молекулы
REINVENT_MODEL_FILE=/home/<user>/REINVENT4/priors/reinvent_pubchem.prior
